<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Nebula glow -->
    <path android:pathData="M54,54m-33,0a33,33 0,1 1,66 0a33,33 0,1 1,-66 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="33">
                <item android:offset="0.0" android:color="#554CC9F0"/>
                <item android:offset="0.6" android:color="#228B5CF6"/>
                <item android:offset="1.0" android:color="#00000000"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer cyan arc -->
    <group android:rotation="200" android:pivotX="54" android:pivotY="54">
        <path
            android:pathData="M54,54m-31,0a31,31 0,1 1,62 0a31,31 0,1 1,-62 0"
            android:strokeColor="#4CC9F0"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:trimPathEnd="0.8"/>
    </group>

    <!-- Middle magenta arc -->
    <group android:rotation="60" android:pivotX="54" android:pivotY="54">
        <path
            android:pathData="M54,54m-22,0a22,22 0,1 1,44 0a22,22 0,1 1,-44 0"
            android:strokeColor="#F72585"
            android:strokeWidth="1.6"
            android:strokeLineCap="round"
            android:trimPathEnd="0.7"/>
    </group>

    <!-- Inner faint ring -->
    <path
        android:pathData="M54,54m-14,0a14,14 0,1 1,28 0a14,14 0,1 1,-28 0"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.35"
        android:strokeWidth="0.8"/>

    <!-- Tilted gold orbit -->
    <group android:rotation="-28" android:pivotX="54" android:pivotY="54">
        <path
            android:pathData="M54,54m-31,0a31,11 0,1 1,62 0a31,11 0,1 1,-62 0"
            android:strokeColor="#FFD166"
            android:strokeAlpha="0.9"
            android:strokeWidth="1.8"/>
    </group>

    <!-- Planet with 3D shading -->
    <path android:pathData="M54,54m-9,0a9,9 0,1 1,18 0a9,9 0,1 1,-18 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="50"
                android:centerY="50"
                android:gradientRadius="14">
                <item android:offset="0.0" android:color="#9BE3FF"/>
                <item android:offset="0.5" android:color="#3A7DFF"/>
                <item android:offset="1.0" android:color="#14217A"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Planet highlight -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.85"
        android:pathData="M50.5,50.5m-1.6,0a1.6,1.6 0,1 1,3.2 0a1.6,1.6 0,1 1,-3.2 0"/>

    <!-- Satellites on orbits -->
    <path
        android:fillColor="#FFD166"
        android:pathData="M77,34.7m-2.4,0a2.4,2.4 0,1 1,4.8 0a2.4,2.4 0,1 1,-4.8 0"/>
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M35,65m-1.8,0a1.8,1.8 0,1 1,3.6 0a1.8,1.8 0,1 1,-3.6 0"/>

    <!-- Four-point sparkles -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M36,34L36,29.5Q36,34 40.5,34Q36,34 36,38.5Q36,34 31.5,34Q36,34 36,29.5Z"/>
    <path
        android:fillColor="#4CC9F0"
        android:pathData="M78,72L78,69Q78,72 81,72Q78,72 78,75Q78,72 75,72Q78,72 78,69Z"/>
